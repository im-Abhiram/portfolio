# Abhiram Anil Portfolio Environment Configuration
DJANGO_SECRET_KEY=change-this-to-a-cryptographically-secure-random-key-in-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,abhiramportfolio.pythonanywhere.com,.pythonanywhere.com

# Google Gemini API Configuration (Free Tier compatible, Server-side only)
# Never expose GEMINI_API_KEY in HTML, JavaScript, or public Git repositories.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_DAILY_ARTICLE_ENABLED=True
GEMINI_ARTICLE_PUBLISH_MODE=review
GEMINI_DAILY_REQUEST_LIMIT=10
GEMINI_CHAT_ENABLED=True
GEMINI_API_TIMEOUT=25
